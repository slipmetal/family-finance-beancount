# Caddy перед fava: страница входа, пароль и код из приложения.
#
# fava своей аутентификации не имеет вообще — ни паролей, ни пользователей.
# Всё, что защищает леджер, находится здесь.
#
# Вход держит плагин caddy-security: он рисует страницу входа, хранит сессию
# в куке, спрашивает код второго фактора и умеет выход. Прежняя связка —
# basic_auth плюс отдельный плагин второго фактора — была устойчивее: дефект
# в плагине деградировал защиту до одного фактора, а не снимал её. Здесь оба
# фактора держит один компонент, и это осознанная плата: всплывающее окно
# браузера не умеет ни выхода, ни внятных ошибок, ни менеджера паролей.
{
	admin off
	# TLS терминирует fly.io, до нас доходит обычный http.
	auto_https off
	log {
		output stdout
		format console
	}

	# Плагин добавляет две директивы, и Caddy обязан знать, в каком порядке их
	# исполнять: authenticate отдаёт страницы портала, authorize стоит перед
	# проксированием и до fava запрос без сессии не пускает.
	order authenticate before respond
	order authorize before reverse_proxy

	security {
		# База пользователей лежит на томе и переживает деплои: в ней
		# привязанные аутентификаторы, то есть второй фактор. Пересоздание
		# файла заставит всех привязывать приложение заново.
		#
		# Сами пользователи объявлены в файле, который генерирует entrypoint
		# из переменной FAVA_USERS: пар «логин — пароль» может быть несколько,
		# а Caddyfile циклов не знает. import разворачивается до разбора
		# структуры, поэтому внутри блока он допустим.
		local identity store localdb {
			realm local
			path /data/auth/users.json

			import /data/auth/portal-users.caddy
		}

		authentication portal fava_portal {
			enable identity store localdb

			# Ключ подписи сессий лежит на томе и переживает перезапуски:
			# иначе каждый деплой разлогинивал бы всех. entrypoint передаёт
			# его через окружение, чтобы ключ не оказался в тексте конфига.
			crypto key sign-verify {env.PORTAL_SIGN_KEY}

			# Сроки жизни сессии — числа, и подстановку {env....} плагин в них
			# не разворачивает: он требует число уже при разборе конфига и
			# спотыкается о саму строку. Поэтому entrypoint подставляет
			# FAVA_SESSION_SECONDS в отдельный файл, а не в окружение.
			import /data/auth/portal-session.caddy

			# insecure off — это кука с флагом Secure. Флаг нужен явно: TLS
			# терминирует fly.io, до Caddy доходит http, и сам он о https
			# не догадается. Побочный эффект — по http войти нельзя.
			cookie insecure off
			cookie samesite lax

			transform user {
				match origin local
				action add role authp/user
				# Второй фактор обязателен. Если аутентификатор ещё не
				# привязан, портал требует привязать его прямо при входе —
				# поэтому на чистом томе никто не остаётся запертым снаружи
				# и заводить секреты заранее, как раньше, не нужно.
				require mfa
			}
			# Пунктов меню здесь нет намеренно: они рисуются на панели
			# портала, а её мы пропускаем (см. route /auth/portal* ниже).
			# Смена пароля и перепривязка аутентификатора — /auth/profile/
			# (слеш на конце обязателен, без него 404), выход — /auth/logout.
		}

		authorization policy fava_policy {
			crypto key verify {env.PORTAL_SIGN_KEY}
			# Портал живёт на том же хосте, поэтому путь относительный.
			set auth url /auth
			allow roles authp/user
		}
	}
}

:8080 {
	# Блоки route взаимоисключающие и проверяются сверху вниз. Проверка
	# живости идёт первой и мимо авторизации: иначе fly.io считал бы машину
	# нездоровой и перезапускал её по кругу. Ничего, кроме слова ok, она
	# не отдаёт.
	route /healthz {
		respond "ok" 200
	}

	# Пройдя вход, портал приводит человека на собственную панель — список
	# плиток, к леджеру отношения не имеющий. Адрес, с которого его завернули
	# на вход, портал не запоминает, а штатная auto_redirect_url требует
	# полный URL с именем хоста, которое тут заранее не известно: локально это
	# localhost, на fly.io — <app>.fly.dev. Поэтому просто отправляем с панели
	# в леджер, относительным редиректом и без лишних настроек.
	# Звёздочка обязательна: без неё `redir / 302` разбирается как «матчер /,
	# адрес 302» и молча превращается в Location: 302.
	route /auth/portal* {
		redir * / 302
	}

	# Страницы входа, выхода и привязки аутентификатора. Сюда же политика
	# отправляет всех, у кого действующей сессии нет.
	route /auth* {
		authenticate with fava_portal
	}

	route {
		authorize with fava_policy
		reverse_proxy 127.0.0.1:5000
	}
}
