# Caddy перед fava: пароль плюс одноразовый код.
#
# fava своей аутентификации не имеет вообще — ни паролей, ни пользователей.
# Всё, что защищает леджер, находится здесь.
#
# Порядок важен: postauth_2fa дополняет basic_auth, а не заменяет его. Сначала
# отрабатывает первый фактор, и только для прошедшего его запроса плагин
# спрашивает код. Поэтому дефект в плагине деградирует защиту до одного
# фактора, а не снимает её совсем.

{
	admin off
	# TLS терминирует fly.io, до нас доходит обычный http.
	auto_https off
	log {
		output stdout
		format console
	}
}

:8080 {
	# Блоки handle взаимоисключающие и проверяются сверху вниз. Проверка
	# живости идёт первой и без пароля: иначе fly.io считал бы машину
	# нездоровой и перезапускал её по кругу. Ничего, кроме слова ok, она
	# не отдаёт.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		# Список пользователей генерирует entrypoint из переменной FAVA_USERS,
		# потому что пар «логин — bcrypt-хеш» может быть несколько.
		basic_auth {
			import /data/auth/basic-users.caddy
		}

		postauth_2fa {
			secrets_file_path /data/auth/2fa-secrets.json
			# Ключ подписи JWT лежит на томе и переживает перезапуски: иначе
			# каждый деплой разлогинивал бы всех.
			sign_key {file./data/auth/jwt-sign-key.txt}
			session_inactivity_timeout 12h
			cookie_name finance_2fa
			# Привязка сессии к IP выключена намеренно: телефон постоянно
			# переключается между Wi-Fi и сотовой сетью, и с ней код пришлось
			# бы вводить по нескольку раз в день. Включить — заменить на true.
			ip_binding false
		}

		reverse_proxy 127.0.0.1:5000
	}
}
