.venv/
# Шаблоны .dockerignore не рекурсивны сами по себе — нужен явный `**/`.
**/__pycache__
**/*.py[cod]
.pytest_cache/
.git/

# Финансовых данных в образе быть не должно — он хранится в реестре fly.io.
# Леджер приезжает на том из своего репозитория, выписки загружаются в браузере.
# Вместе с леджером на том приезжают rules.yaml и accounts.yaml; в образе
# остаются только образцы.
ledger/
inbox/
documents/
out.beancount
rules.yaml
accounts.yaml

# Карта замен для сборки фикстур: в ней настоящие имена и номера.
tools/anonymize.yaml

# Тесты, фикстуры и CI в рантайме не нужны.
tests/
.github/
