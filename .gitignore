.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Локальные настройки инструментов, у каждого свои.
.claude/

# Леджер живёт в отдельном приватном репозитории и клонируется сюда:
#   git clone git@github.com:slipmetal/family-ledger-data.git ledger
# Здесь его быть не должно — в этом репозитории только код. Вместе с проводками
# там же лежат rules.yaml и accounts.yaml: в них фамилии контрагентов, номера
# счетов и список мерчантов. В кодовом репозитории только образцы — файлы
# rules.example.yaml и accounts.example.yaml.
ledger/

# На случай, если настоящие правила или список счетов положили в корень.
/rules.yaml
/accounts.yaml

# Карта замен для сборки тестовых фикстур: в ней настоящие имена и номера.
tools/anonymize.yaml

# Банковские выписки: персональные данные, в репозиторий не идут.
documents/*
!documents/.gitkeep
inbox/*
!inbox/.gitkeep

# Черновой вывод импорта до переноса в леджер.
out.beancount